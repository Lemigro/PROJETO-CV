---
const { currentLang } = Astro.props;
---

<div class="lang-switcher">
  <a href="/" class={`lang-tab ${currentLang === 'pt-BR' ? 'active' : ''}`} title="Português">
    PT
  </a>
  
  <a href="/en" class={`lang-tab ${currentLang === 'en-US' ? 'active' : ''}`} title="English">
    EN
  </a>
</div>

<style>
  .lang-switcher {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    background: var(--rpg-dark-brown);
    border: 2px solid var(--rpg-gold);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    z-index: 10;
  }

  .lang-tab {
    padding: 6px 14px;
    text-decoration: none;
    color: var(--rpg-parchment);
    font-weight: bold;
    font-size: 0.9rem;
    font-family: 'Cinzel', serif;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .lang-tab:hover {
    background: rgba(212, 175, 55, 0.2);
  }

  .lang-tab.active {
    background: var(--rpg-gold);
    color: var(--rpg-dark-brown);
    pointer-events: none; 
  }

  @media (max-width: 768px) {
    .lang-switcher {
      position: relative;
      top: 0;
      right: 0;
      width: max-content;
      margin: 0 auto 15px auto;
    }
  }
</style>